# xcodegen output — regenerate with `xcodegen generate`
YatseRemote.xcodeproj/
YatseRemote/Info.plist
DerivedData/
build/
*.ipa
*.sha256
xcuserdata/
*.xcuserstate
.DS_Store

# OpenSpec Hermes skills generated into the repo by `openspec init`
# (the same skills are already installed globally in ~/.hermes/skills)
.hermes/

# Local handoff notes and specs — deliberately not published. AGENT.md carries
# this box's paths and the development host, and openspec/ is working material,
# so both live on disk and out of the repo. (They remain in the history of the
# commits made before this was noticed.)
AGENT.md
docs/AGENT-PROMPT.md
openspec/

# Build output from the local release helper (scripts/), plus anything it drops
dist/

# Agent scratch — a tool's local state or instruction files, not this project.
# CLAUDE.md and AGENTS.md are the ones an agent writes without being asked; the
# rest are tool state that arrives with one.
CLAUDE.md
AGENTS.md
.claude/
.codex/
.opencode/
.cursor/
.aider*

# Python bytecode (scripts/check-host.py)
__pycache__/
*.pyc
